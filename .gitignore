__pycache__/
*.pyc

# tm's runtime state. It lives in the repo directory (not ~/.tm) so it is easy to
# browse, but it is not code: queue contents, run records, the lock and the pause
# flag stay out of version control.
/queue/
/runs/
/archive/
/lock
/paused
/.writable
/.pruning/

# Your own task lists. The directory is kept via .gitkeep, the contents are not
# tracked: experiment lists change constantly and do not belong in the tool's
# history. See task_list.example.yaml for the template.
/lists/*
!/lists/.gitkeep

# Local development material; not published.
/claude_notes/
/testbench/
