# Put your own task lists here. The contents are gitignored: experiment lists change
# constantly and should not clutter the tool's history. This file only exists so the
# directory survives a clone.
#
# task_list.example.yaml in the repo root is the tracked template to copy from.
#
#   cp task_list.example.yaml lists/myrun.yaml
#   tm add lists/myrun.yaml
